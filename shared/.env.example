# FinanceAI environment variables: the single list for every service.
#
# Copy this file to a .env file (never committed; see .gitignore) and fill in real values.
# Each variable is defined exactly once here. python-worker and node-api read the
# SAME names, so both services always see the same values (for example the embedding
# deployment and the search index name).
#
# "Read by" tells you which service loads each variable.
# Values in <angle brackets> are placeholders; anything else is a default.
#
# Authentication: every *_API_KEY / *_CONNECTION_STRING / *_PASSWORD is OPTIONAL.
# When it is empty, the service authenticates with DefaultAzureCredential
# (az login locally, workload identity on AKS). See shared/README.md.

# -----------------------------------------------------------------------------
# Azure OpenAI. Read by: python-worker, node-api
# -----------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<openai-resource-name>.openai.azure.com/
# Optional. Empty = use DefaultAzureCredential.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=<api-version>
# The ONE embedding deployment. Python uses it to index chunks and Node uses it to embed
# queries; they must match, or vector search returns garbage. Never hard-code a model name.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=<embedding-deployment-name>
# Vector length the embedding deployment returns. The AI Search vector field uses this
# (see shared/search/index-fields.json). Changing it requires recreating the index.
AZURE_OPENAI_EMBEDDING_DIMENSIONS=<integer>
# Chat deployment: KPI extraction (python-worker) and RAG answers (node-api).
AZURE_OPENAI_CHAT_DEPLOYMENT=<chat-deployment-name>

# -----------------------------------------------------------------------------
# Azure AI Document Intelligence. Read by: python-worker
# -----------------------------------------------------------------------------
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<document-intelligence-resource-name>.cognitiveservices.azure.com/
# Optional. Empty = use DefaultAzureCredential.
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=

# -----------------------------------------------------------------------------
# Azure AI Search. Read by: python-worker (creates the index, uploads chunks),
# node-api (queries)
# -----------------------------------------------------------------------------
AZURE_SEARCH_ENDPOINT=https://<search-service-name>.search.windows.net
# Optional. Empty = use DefaultAzureCredential.
AZURE_SEARCH_API_KEY=
# The ONE index name both services use. Fields: shared/search/index-fields.json.
AZURE_SEARCH_INDEX_NAME=<index-name>

# -----------------------------------------------------------------------------
# Azure Storage (Blob + Queue). Read by: python-worker, node-api
# -----------------------------------------------------------------------------
# Optional. When set (e.g. Azurite for local dev), it is used instead of the two
# endpoints below plus DefaultAzureCredential.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_BLOB_ENDPOINT=https://<storage-account-name>.blob.core.windows.net
AZURE_STORAGE_QUEUE_ENDPOINT=https://<storage-account-name>.queue.core.windows.net
# Container that holds the uploaded PDFs.
AZURE_STORAGE_BLOB_CONTAINER=<blob-container-name>
# Ingestion queue. Message format: shared/schemas/ingestion-queue-message.schema.json
AZURE_STORAGE_QUEUE_NAME=<queue-name>

# -----------------------------------------------------------------------------
# Azure SQL. Read by: python-worker, node-api
# Each service builds its own connection from these parts
# (python: SQLAlchemy + pyodbc, node: mssql).
# -----------------------------------------------------------------------------
AZURE_SQL_SERVER=<sql-server-name>.database.windows.net
AZURE_SQL_PORT=1433
AZURE_SQL_DATABASE=<database-name>
# Optional. Empty user + password = use Entra ID (DefaultAzureCredential).
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=
AZURE_SQL_ENCRYPT=true
# Set to true only for a local SQL Server container with a self-signed certificate.
AZURE_SQL_TRUST_SERVER_CERTIFICATE=false

# -----------------------------------------------------------------------------
# node-api runtime. Read by: node-api
# -----------------------------------------------------------------------------
# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Origin allowed to call the API from a browser (the frontend URL).
CORS_ORIGIN=<frontend-origin>
# Largest PDF accepted by POST /documents, in bytes.
UPLOAD_MAX_BYTES=<integer>

# -----------------------------------------------------------------------------
# frontend (Vite, build time). Read by: frontend
# -----------------------------------------------------------------------------
# Base URL of node-api as seen from the browser.
VITE_API_BASE_URL=<node-api-base-url>
